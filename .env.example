# Server-side variables only — none of these are exposed to the browser
# (a VITE_ prefix would be). Copy this file to .env.local for local
# development; on Vercel, set the same names in the project settings.

# Resend — sends every lead form to the DESA inbox (api/contact.js).
# Without it /api/contact answers 503 and the form shows an inline error.
RESEND_API_KEY=re_your_key_here

# Optional: where leads are delivered, and the sender identity they arrive
# from. LEADS_FROM must be an address on a domain verified in Resend —
# onboarding@resend.dev only works while the account has no verified domain.
LEADS_INBOX=desacontact.01@gmail.com
LEADS_FROM=DESA Menu Leads <onboarding@resend.dev>

# Supabase (optional) — without these the bundled demo content is used and
# inquiries are kept in memory only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
